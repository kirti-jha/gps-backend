# =============================================
# TrackX GPS Backend — Environment Variables
# =============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Server ---
PORT=5000

# --- Security (REQUIRED) ---
# Generate with: node -e "require('crypto').randomBytes(48,(e,b)=>console.log(b.toString('hex')))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# --- Seed User Passwords (development only) ---
# Change these before deploying to production
SEED_ADMIN_PASSWORD=admin123
SEED_KIRTI_PASSWORD=changeme123

# --- Routing (optional) ---
# Override OSRM URL for self-hosted routing engine
# OSRM_URL=http://your-osrm-server.com
